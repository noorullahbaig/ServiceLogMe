{
  "name": "servicelogme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed:d1": "tsx scripts/seed-d1.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:vinext:staging": "vinext-cloudflare deploy --env staging"
  },
  "dependencies": {
    "@fontsource/geist": "latest",
    "@fontsource/geist-mono": "latest",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@react-pdf/renderer": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-table": "^8.21.3",
    "decimal.js": "latest",
    "jose": "^6.2.12",
    "lucide-react": "latest",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "latest",
    "sharp": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "latest",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "vitest": "latest"
  },
  "type": "module"
